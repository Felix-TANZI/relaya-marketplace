# config/reel.env.example — SITE RÉEL (DEV-SRV-01, T04)
#
# Modèle des réglages du site réel. Ce fichier ne contient AUCUN secret et ne se copie pas sur le serveur : chaque
# valeur se renseigne dans GitHub > Settings > Environments > <environnement du serveur>, et deploy.yml génère
# .env.prod à chaque déploiement. « secret » = Secrets, sinon = Variables.
#
# Ce qui distingue le site réel de la vitrine tient dans la première section ; le reste est commun.

# ── Version déployée ─────────────────────────────────────────────────────────────────────────────────────────────
BELIVAY_COMPOSE=docker-compose.reel.yml              # vide = vitrine (docker-compose.prod.yml)

# ── Adresses (ops/SITE-REEL.md) ──────────────────────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=api.belivay.com
CORS_ALLOWED_ORIGINS=https://seller.belivay.com,https://admin.belivay.com,https://relay.belivay.com,https://driver.belivay.com,https://delivery.belivay.com,https://shop.belivay.com
CSRF_TRUSTED_ORIGINS=https://api.belivay.com
VITE_API_URL=https://api.belivay.com                 # les écrans appellent cette seule adresse (T10)
VITE_SITE_URL=https://shop.belivay.com               # https://belivay.com à partir du 14/12 (T21)
FRONTEND_URL=https://shop.belivay.com                # liens des e-mails, plans du site
BACKEND_URL=https://api.belivay.com

# ── Données (règle R4) ───────────────────────────────────────────────────────────────────────────────────────────
DONNEES_DEMO_AUTORISEES=0                            # jamais 1 sur le site réel
COMPTES_DEMO_AUTORISES=0

# ── Base de données ──────────────────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=belivay
POSTGRES_USER=belivay
POSTGRES_PASSWORD=                                   # secret
DJANGO_SECRET_KEY=                                   # secret
WEB_CONCURRENCY=9

# ── Pièces et images sur R2 (règle R8) ───────────────────────────────────────────────────────────────────────────
USE_R2_STORAGE=1
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=                                   # secret
AWS_SECRET_ACCESS_KEY=                               # secret

# ── Sauvegardes chiffrées sur R2 (T06, ops/sauvegarde/LISEZMOI.md) ───────────────────────────────────────────────
BACKUP_R2_BUCKET=belivay-sauvegardes
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=                             # secret
BACKUP_R2_SECRET_ACCESS_KEY=                         # secret
BACKUP_AGE_RECIPIENT=                                # clé PUBLIQUE age1… (jamais la clé privée)

# ── Paiement : CamPay en mode test jusqu'au 14/12 (règle R7, T21) ────────────────────────────────────────────────
CAMPAY_TOKEN_SANDBOX=                                # secret
CAMPAY_TOKEN_LIVE=                                   # secret — posé le 14/12 seulement, avec la direction
CAMPAY_WEBHOOK_KEY=                                  # secret
PAYMENTS_ENCRYPTION_KEY=                             # secret
PAYMENTS_FINGERPRINT_SALT=                           # secret

# ── Le reste (e-mail, Google, WhatsApp, IA) : comme aujourd'hui, voir .github/workflows/deploy.yml ────────────────
