# config/vitrine.env.example — VITRINE de démonstration (DEV-SRV-01, T04)
#
# Modèle des réglages de la vitrine. AUCUN secret ici : les valeurs se renseignent dans l'environnement GitHub du
# serveur de la vitrine, et deploy.yml génère .env.prod. « secret » = Secrets, sinon = Variables.
#
# Règles R1 à R3 et R6 : deux back-ends, deux bases, aucun croisement ; la vitrine ne crée jamais un compte réel ;
# SMS, vérification d'identité et paiement y sont simulés ; bandeau « Démonstration », fermée aux moteurs.

# ── Version déployée ─────────────────────────────────────────────────────────────────────────────────────────────
BELIVAY_COMPOSE=                                     # vide = vitrine (docker-compose.prod.yml, nginx/nginx.conf)

# ── Adresses ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Aujourd'hui, la vitrine sert belivay.com (/, /vendeur/, /relais/…). Ses adresses françaises (boutique., vendeur.,
# relais., livreur., livraison.belivay.com) et son back-end api-demo.belivay.com restent à mettre en place (T08, T13).
ALLOWED_HOSTS=belivay.com,www.belivay.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ── Données de démonstration (règle R4 : jamais sur le site réel) ────────────────────────────────────────────────
# La base de la vitrine se remplit à la main : DONNEES_DEMO_AUTORISEES=1 python manage.py charger_demonstration
DONNEES_DEMO_AUTORISEES=1
COMPTES_DEMO_AUTORISES=1

# ── Base de données : la sienne, jamais celle du site réel (règle R1) ────────────────────────────────────────────
POSTGRES_DB=belivay_demo
POSTGRES_USER=belivay_demo
POSTGRES_PASSWORD=                                   # secret
DJANGO_SECRET_KEY=                                   # secret, différent de celui du site réel

# ── Paiement simulé (règle R3) ───────────────────────────────────────────────────────────────────────────────────
# Le prestataire factice MOCK reste actif ici (charger_reference ne le coupe que sur le site réel).
CAMPAY_TOKEN_SANDBOX=
CAMPAY_TOKEN_LIVE=                                   # TOUJOURS vide sur la vitrine

# ── Comptes de la vitrine (vitrine/site/serveur, PR-VITRINE.md) ──────────────────────────────────────────────────
# Règle R2 : « la vitrine ne crée jamais un compte réel ». Le service vitrine-comptes crée aujourd'hui de vrais
# comptes sur Neon : à trancher avec JUNIOR (T08) — le laisser fermé (variables vides) ou le brancher sur une base
# de démonstration.
COMPTES_DATABASE_URL=
