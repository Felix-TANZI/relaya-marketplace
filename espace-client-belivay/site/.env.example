# Variables d'environnement du site BelivaY (espace client).
#
# Copier ce fichier en .env.local (jamais suivi par git) et remplir ce qui sert. Sur Vercel : Réglages → Environment
# Variables. Vite n'expose au navigateur que les variables VITE_ : tout ce qui est ici est PUBLIC (visible dans le
# code envoyé au navigateur). Jamais de secret ici : les clés secrètes vont sur le serveur (relaya-marketplace),
# listées à la fin pour mémoire. Validation et valeurs par défaut : src/config/env.ts ; services : CONNECTEURS.md.

# ——— Données ———

# D'où viennent les données : « demo » (défaut : démonstration en localStorage) ou « api » (le serveur).
VITE_SOURCE=demo
# Adresse de l'API, préfixe /api compris, sans barre finale. Obligatoire avec VITE_SOURCE=api ; HTTPS en production.
# « /api » si le site et l'API sont servis depuis la même origine (réécriture Vercel ou nginx).
# VITE_API_URL=https://belivay.com/api
# Délai d'expiration d'une requête, en millisecondes (1000 à 120000 ; défaut 15000).
# VITE_API_DELAI_MS=15000
# Nouvelles tentatives d'une lecture (GET) après une panne réseau, un 502/503/504 (0 à 5 ; défaut 2).
# VITE_API_TENTATIVES=2

# « 1 » : bandeau « démonstration » en haut du site (déploiement public de la démo).
# VITE_DEMO=1

# ——— Cartes et géocodage (src/connecteurs/cartes.ts) ———

# « osm » (défaut : OpenStreetMap et Nominatim, sans clé) ou « google ».
# VITE_MAPS=osm
# Clé publique Google Maps (Maps JavaScript, Places « nouveau », Geocoding), limitée aux domaines du site.
# Sans elle, VITE_MAPS=google se replie sur OpenStreetMap.
# VITE_GOOGLE_MAPS_KEY=
# Identifiant de carte Google (marqueurs avancés, style) ; facultatif.
# VITE_GOOGLE_MAPS_MAP_ID=

# ——— Notifications push (src/connecteurs/push.ts, public/sw.js) ———

# Clé publique VAPID (base64url, 87 caractères : « npx web-push generate-vapid-keys »). La clé privée va sur le
# serveur. Sans elle : notification locale seulement (démonstration).
# VITE_VAPID_PUBLIC_KEY=

# ——— Suivi d'erreurs et mesure d'audience (src/connecteurs/suivi.ts) ———

# Point de collecte des erreurs non attrapées (POST JSON). Sans lui : console en développement.
# VITE_ERREURS_URL=
# Point de collecte de la mesure d'audience (POST JSON), seulement avec l'accord du client.
# VITE_MESURE_URL=
# Version déployée jointe aux rapports d'erreur (ex. le commit).
# VITE_VERSION=

# ——— Connexion Google et Apple (à brancher : SDK pas encore chargés, voir CONNECTEURS.md) ———

# Identifiant client OAuth web de Google (le même que GOOGLE_CLIENT_ID du serveur).
# VITE_GOOGLE_CLIENT_ID=
# Services ID de Sign in with Apple (un des APPLE_CLIENT_IDS du serveur).
# VITE_APPLE_CLIENT_ID=

# ——— Paiement par carte, Apple Pay, Google Pay (src/connecteurs/paiementCarte.ts) ———

# Qui tokenise la carte dans le navigateur : « demo » (défaut : jeton simulé tok_demo_…), « cinetpay » ou
# « flutterwave » (SDK chargé au premier paiement par carte ; demande la clé ci-dessous). Le numéro complet et le
# code au dos ne sont jamais envoyés à BelivaY : seuls le jeton, la marque, les 4 derniers chiffres et le BIN.
# VITE_CARTE_FOURNISSEUR=demo
# Clé PUBLIABLE du prestataire carte (3-D Secure). La clé secrète reste sur le serveur (refusée ici).
# VITE_CARTE_CLE_PUBLIQUE=
# Identifiants marchands Apple Pay et Google Pay, donnés par le prestataire.
# VITE_APPLE_PAY_MARCHAND=
# VITE_GOOGLE_PAY_MARCHAND=

# ——— Pour mémoire : variables du SERVEUR (relaya-marketplace), jamais dans ce fichier ———
# Paiement Mobile Money (Campay) : CAMPAY_TOKEN_SANDBOX, CAMPAY_TOKEN_LIVE, CAMPAY_WEBHOOK_KEY,
#   PAYMENTS_ENCRYPTION_KEY, PAYMENTS_FINGERPRINT_SALT
# Connexion : GOOGLE_CLIENT_ID, APPLE_CLIENT_IDS, APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY
# E-mail : EMAIL_BACKEND, EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, CELERY_BROKER_URL
# Photos (Cloudflare R2) : USE_R2_STORAGE, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_STORAGE_BUCKET_NAME,
#   AWS_S3_ENDPOINT_URL
# CORS : FRONTEND_URL (origine du site)
# À créer : SMS_FOURNISSEUR, SMS_CLE_API, SMS_EXPEDITEUR ; VAPID_CLE_PRIVEE, VAPID_SUJET ; CARTE_CLE_SECRETE,
#   CARTE_SECRET_WEBHOOK ; SENTRY_DSN
