FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_API_URL
ARG VITE_PORTAL_ROLE=client
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_MAP_PROVIDER=openstreetmap
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_PORTAL_ROLE=$VITE_PORTAL_ROLE
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY
ENV VITE_MAP_PROVIDER=$VITE_MAP_PROVIDER

COPY package*.json ./
# --legacy-peer-deps : @codetrix-studio/capacitor-google-auth (utilise pour
# la connexion Google native des apps mobiles) demande @capacitor/core@^6,
# alors que le projet est sur @capacitor/core@^7. Le plugin fonctionne en
# pratique avec la v7 (teste), mais npm ci refuse ce conflit par defaut.
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
