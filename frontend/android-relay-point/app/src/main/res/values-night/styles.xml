<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Variante sombre.

        L'en-tete du portail passe en ardoise (#0F172A) : les icones de la
        barre d'etat doivent redevenir claires, sinon elles disparaissent a
        leur tour. Le theme parent etant `DayNight`, Android bascule seul sur
        ce fichier quand le telephone est en mode sombre.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
