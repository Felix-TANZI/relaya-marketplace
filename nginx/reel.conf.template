    server_name courier.${BELIVAY_DOMAINE};
    ssl_certificate /etc/letsencrypt/live/${BELIVAY_DOMAINE}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BELIVAY_DOMAINE}/privkey.pem;
