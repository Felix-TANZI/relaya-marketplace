# nginx/reel.conf.template — SITE RÉEL seul (MAIN 2, puis MAIN 1 après la bascule) — DEV-SRV-01, T05 / T11.
#
# DEV-SRV-01 v1.8, C02 : les noms ne sont plus écrits ici. nginx remplit ce modèle au démarrage (image officielle :
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/) avec BELIVAY_DOMAINE, défini dans .env.prod :
#   belivay.com       site réel (valeur par défaut : rien ne change)       -> api.belivay.com, seller.belivay.com…
#   test.belivay.com  serveur de test MAIN 2 (T20)                          -> api.test.belivay.com, seller.test.belivay.com…
# Le certificat porte le même nom que le domaine (/etc/letsencrypt/live/<BELIVAY_DOMAINE>/). Seules les variables
# définies dans l'environnement sont remplacées : $host, $uri, $request_uri… restent ceux de nginx.
#
# Une seule porte vers le serveur : api.belivay.com. Les portails ne servent que leurs écrans et les appellent
# (décision du porteur du 2026-11-08 ; T10 : « le site réel n'appelle que api.belivay.com »). Aucune vitrine, aucun
# serveur de comptes Neon ici (règles R1, R2) : la vitrine garde nginx/nginx.conf.
#
#   api.belivay.com       back-end Django (/api/, /django-admin/, /static/, /media/ hors pièces)
#   seller.belivay.com    vendeur            driver.belivay.com    livreur
#   relay.belivay.com     point relais       delivery.belivay.com  entreprise de livraison
#   admin.belivay.com     administration     shop.belivay.com      client (belivay.com le 14/12, T21)
#
# Anciennes adresses (décision du porteur) : courier → driver, relay-point → relay, delivery-org → delivery, en
# redirection permanente qui garde le reste du lien.
#
# Choisi par docker-compose.reel.yml (deploy.sh, BELIVAY_COMPOSE=docker-compose.reel.yml dans .env.prod).
# Maintenance (T14/T18) : fichier témoin nginx/maintenance/actif (ops/transfert/maintenance.sh).
# Certificat : un seul, « belivay.com », qui doit couvrir toutes les adresses ci-dessus (ops/SITE-REEL.md).

upstream backend {
    server backend:8000;
}
upstream frontend_client {
    server frontend-client:80;
}
upstream frontend_seller {
    server frontend-seller:80;
}
upstream frontend_courier {
    server frontend-courier:80;
}
upstream frontend_admin {
    server frontend-admin:80;
}
upstream frontend_relay_point {
    server frontend-relay-point:80;
}
upstream frontend_delivery_org {
    server frontend-delivery-org:80;
}

# DEV-SRV-01, T21 / T22 : configurations du lancement, préparées dans nginx/lancement-pret/ et activées le 14/12
# par ops/lancement/activer.sh (copie dans nginx/lancement/). Dossier vide = rien d'activé.
include /etc/nginx/lancement/*.conf;

# HTTP → HTTPS pour toutes les adresses, anciennes comprises ; certbot répond sur /.well-known/.
server {
    listen 80;
    server_name api.${BELIVAY_DOMAINE} shop.${BELIVAY_DOMAINE} seller.${BELIVAY_DOMAINE} driver.${BELIVAY_DOMAINE} relay.${BELIVAY_DOMAINE}
                delivery.${BELIVAY_DOMAINE} admin.${BELIVAY_DOMAINE} courier.${BELIVAY_DOMAINE} relay-point.${BELIVAY_DOMAINE}
                delivery-org.${BELIVAY_DOMAINE};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── API : la seule porte vers le back-end ────────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    server_name api.${BELIVAY_DOMAINE};
    client_max_body_size 100M;

    ssl_certificate /etc/letsencrypt/live/${BELIVAY_DOMAINE}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BELIVAY_DOMAINE}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # DEV-SRV-01, T14 / T18 : maintenance (« plus aucune écriture possible ») tant que nginx/maintenance/actif existe
    # (ops/transfert/maintenance.sh). La page elle-même échappe au blocage, sinon elle serait bloquée à son tour.
    set $maintenance 0;
    if (-f /etc/nginx/maintenance/actif) { set $maintenance 1; }
    if ($uri = /__maintenance.html) { set $maintenance 0; }
    if ($maintenance = 1) { return 503; }
    error_page 503 /__maintenance.html;
    location = /__maintenance.html { root /etc/nginx/maintenance; internal; }

    location /api/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /django-admin/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        alias /app/staticfiles/;
    }

    # Tâche D19 : les pièces d'identité ne sont jamais servies en direct (lecture par l'API, qui vérifie qui
    # demande ; elles sont d'ailleurs sur R2 depuis la règle R8).
    location /media/compliance/ {
        return 404;
    }

    location /media/ {
        alias /app/mediafiles/;
    }

    location / {
        return 404;
    }
}

# ── Portails : leurs écrans seulement (images envoyées avant R2 encore lues sous /media/) ─────────────────────────
